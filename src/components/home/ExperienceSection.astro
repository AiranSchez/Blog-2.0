---
interface ExperienceData {
  company: string;
  role: string;
  startDate: string;
  endDate: string | null;
  description?: string;
  technologies?: string[];
}

interface Props {
  experiences: { id: string; data: ExperienceData }[];
  t: (key: any) => string;
  lang: string;
}

const { experiences, t, lang } = Astro.props as Props;

const intro = {
  en: 'A path through data, product development, backend systems, and the internal tools that help teams work better.',
  es: 'Un recorrido por datos, producto, sistemas backend y las herramientas internas que ayudan a los equipos a trabajar mejor.',
  ja: 'データ、プロダクト開発、バックエンド、そしてチームを支える社内ツールに取り組んできました。',
}[lang as 'en' | 'es' | 'ja'];

const kicker = {
  en: 'Journey',
  es: 'Trayectoria',
  ja: '経歴',
}[lang as 'en' | 'es' | 'ja'];

const formatDate = (value: string | null) => {
  if (!value) return t('experience.present');
  const date = new Date(`${value}-01T00:00:00`);
  return new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short' }).format(date);
};

const formatDuration = (startDate: string, endDate: string | null) => {
  const [startYear, startMonth] = startDate.split('-').map(Number);
  const now = new Date();
  const [endYear, endMonth] = endDate
    ? endDate.split('-').map(Number)
    : [now.getFullYear(), now.getMonth() + 1];
  const totalMonths = Math.max(1, (endYear - startYear) * 12 + endMonth - startMonth);
  const years = Math.floor(totalMonths / 12);
  const months = totalMonths % 12;

  if (lang === 'ja') {
    return years > 0 ? `${years}年${months > 0 ? `${months}ヶ月` : ''}` : `${months}ヶ月`;
  }

  const labels = lang === 'es'
    ? { year: 'año', years: 'años', month: 'mes', months: 'meses', join: ' y ' }
    : { year: 'year', years: 'years', month: 'month', months: 'months', join: ' and ' };
  const parts = [];

  if (years > 0) parts.push(`${years} ${years === 1 ? labels.year : labels.years}`);
  if (months > 0) parts.push(`${months} ${months === 1 ? labels.month : labels.months}`);
  return parts.join(labels.join);
};
---

<section id="experience" class="content-section content-section--experience" aria-labelledby="experience-heading">
  <div class="site-container">
    <header class="section-head">
      <div>
        <span class="section-kicker">{kicker}</span>
        <h2 id="experience-heading" class="section-heading">{t('experience.title')}</h2>
      </div>
      <p class="section-intro">{intro}</p>
    </header>

    <ol class="home-timeline">
      {experiences.map((experience, index) => (
        <li class:list={{ 'is-current': index === 0 }}>
          <div class="home-timeline__meta">
            <time class="experience-period">
              {formatDate(experience.data.startDate)} — {formatDate(experience.data.endDate)}
            </time>
            <span class="experience-duration">
              {formatDuration(experience.data.startDate, experience.data.endDate)}
            </span>
          </div>
          <div class="home-timeline__content">
            <h3 class="experience-role">{experience.data.role}</h3>
            <p class="experience-company">{experience.data.company}</p>
            {experience.data.description && (
              <p class="experience-description">{experience.data.description}</p>
            )}
            {experience.data.technologies && (
              <div class="tag-list" aria-label="Technologies">
                {experience.data.technologies.slice(0, index === 0 ? 8 : 6).map((technology) => (
                  <span class="tag">{technology}</span>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
