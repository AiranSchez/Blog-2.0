---
interface ExperienceData {
  company: string;
  role: string;
  startDate: string;
  endDate: string | null;
  description?: string;
  technologies?: string[];
}

interface Props {
  experiences: { id: string; data: ExperienceData }[];
  t: (key: any) => string;
  lang: string;
}

const { experiences, t, lang } = Astro.props as Props;

const copy = {
  es: { full: 'Ver CV completo', previous: 'Experiencia anterior' },
  en: { full: 'View full CV', previous: 'Earlier experience' },
  ja: { full: '経歴の詳細', previous: 'これまでの経験' },
}[lang as 'en' | 'es' | 'ja'];

const formatDate = (value: string | null) => {
  if (!value) return t('experience.present');
  const date = new Date(`${value}-01T00:00:00`);
  return new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short' }).format(date);
};

const formatDuration = (startDate: string, endDate: string | null) => {
  const [startYear, startMonth] = startDate.split('-').map(Number);
  const now = new Date();
  const [endYear, endMonth] = endDate
    ? endDate.split('-').map(Number)
    : [now.getFullYear(), now.getMonth() + 1];
  const totalMonths = Math.max(1, (endYear - startYear) * 12 + endMonth - startMonth);
  const years = Math.floor(totalMonths / 12);
  const months = totalMonths % 12;

  if (lang === 'ja') {
    return years > 0 ? `${years}年${months > 0 ? `${months}ヶ月` : ''}` : `${months}ヶ月`;
  }

  const labels = lang === 'es'
    ? { year: 'año', years: 'años', month: 'mes', months: 'meses', join: ' y ' }
    : { year: 'year', years: 'years', month: 'month', months: 'months', join: ' and ' };
  const parts = [];

  if (years > 0) parts.push(`${years} ${years === 1 ? labels.year : labels.years}`);
  if (months > 0) parts.push(`${months} ${months === 1 ? labels.month : labels.months}`);
  return parts.join(labels.join);
};
---

<section id="experience" class="content-section portfolio-career" aria-labelledby="experience-heading">
  <div class="site-container">
    <header class="portfolio-section-head">
      <div><h2 id="experience-heading">{t('experience.title')}</h2></div>
      <a class="portfolio-inline-link" href={`/${lang}/cv/`}>{copy.full} ↗</a>
    </header>
    {[experiences.slice(0, 1), experiences.slice(1)].map((group, index) => {
      const Container = index === 0 ? 'div' : 'details';
      return <Container class={index === 0 ? 'career-current' : 'career-history'}>
        {index === 1 && <summary>{copy.previous}<span aria-hidden="true">＋</span></summary>}
        <ol class="career-list">
          {group.map(experience => <li>
            <div class="career-date"><time>{formatDate(experience.data.startDate)} — {formatDate(experience.data.endDate)}</time><span>{formatDuration(experience.data.startDate, experience.data.endDate)}</span></div>
            <div class="career-description"><h3>{experience.data.role}</h3><p class="career-company">{experience.data.company}</p><p>{experience.data.description}</p><div class="career-technologies">{experience.data.technologies?.slice(0, 4).map(technology => <span>{technology}</span>)}</div></div>
          </li>)}
        </ol>
      </Container>;
    })}
  </div>
</section>
