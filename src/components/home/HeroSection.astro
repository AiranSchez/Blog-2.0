---
import { Image } from 'astro:assets';
import profileImage from '../../assets/images/profile/DSC01235.jpg';
import type { PortfolioLocale } from '../../data/portfolio-content';
interface Props { lang: PortfolioLocale }
const { lang } = Astro.props;
const copy = {
  es: { place: 'Canarias ↔ Japón', position: 'Desarrollador de software.\nEntre datos, web y sistemas.', summary: 'Entender el problema, conectar las piezas y construir con el equipo.', primary: 'Explorar mi trabajo', contact: 'Hablemos', portrait: 'Airán Sánchez con un pato de goma en la cabeza', now: 'LeanMind · TechnyFarma' },
  en: { place: 'Canary Islands ↔ Japan', position: 'Software developer.\nAcross data, web and systems.', summary: 'Understand the problem, connect the pieces and build with the team.', primary: 'Explore my work', contact: 'Let’s talk', portrait: 'Airán Sánchez with a rubber duck on his head', now: 'LeanMind · TechnyFarma' },
  ja: { place: 'カナリア諸島 ↔ 日本', position: 'ソフトウェア開発者。\nデータ、ウェブ、システムをつなぐ。', summary: '課題を理解し、チームで育てる。', primary: 'つくったものを見る', contact: '話してみる', portrait: '頭にラバーダックを乗せたAirán Sánchez', now: 'LeanMind · TechnyFarma' },
}[lang];
---
<!-- Hallmark · custom: Carbon / Citron · structure: identity → evidence · designed-as-app -->
<section id="intro" class="profile-hero" aria-labelledby="hero-title">
  <div class="site-container profile-composition">
    <div class="profile-identity"><p>{copy.place}</p><span>{copy.now}</span></div>
    <Image src={profileImage} alt={copy.portrait} widths={[160, 320, 640]} sizes="(min-width: 960px) 400px, 80px" width={640} height={640} loading="eager" fetchpriority="high" class="profile-portrait" />
    <h1 id="hero-title"><span>Airán</span> <span>Sánchez<span class="profile-period">.</span></span></h1>
    <div class="profile-intro">
      <p class="profile-position">{copy.position}</p>
      <p class="profile-summary">{copy.summary}</p>
      <div class="profile-actions">
        <a class="portfolio-action" href="#work">{copy.primary}<span aria-hidden="true">↘</span></a>
        <a class="portfolio-text-action" href="#contact">{copy.contact}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
