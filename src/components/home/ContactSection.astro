---
interface Props {
  t: (key: string) => string;
  lang: string;
}

const { t, lang } = Astro.props;

const kicker = {
  en: '09 · Contact',
  es: '09 · Contacto',
  ja: '09 · お問い合わせ',
}[lang as 'en' | 'es' | 'ja'];

const statusClasses = {
  success: 'p-4 text-center font-semibold',
  error: 'p-4 text-center font-semibold',
};
---

<section id="contact" class="content-section content-section--contact" aria-labelledby="contact-heading">
  <div class="site-container contact-stage">
    <div class="contact-stage__intro">
      <span class="section-kicker">{kicker}</span>
      <h2 id="contact-heading" class="section-heading">{t('contact.title')}</h2>
      <p class="contact-copy">{t('contact.subtitle')}</p>
      <a class="text-link" href="mailto:airanschez0@gmail.com">airanschez0@gmail.com</a>
    </div>

    <form
      id="contact-form"
      class="editorial-form"
      data-sending={t('contact.sending')}
      data-success={t('contact.success')}
      data-error={t('contact.error')}
      data-class-success={statusClasses.success}
      data-class-error={statusClasses.error}
    >
      <input type="hidden" name="access_key" value={import.meta.env.WEB3FORMS_ACCESS_KEY || 'your_key_here'} />

      <div>
        <label for="contact-name">{t('contact.name')} *</label>
        <input
          type="text"
          name="name"
          id="contact-name"
          placeholder={t('contact.name')}
          required
          autocomplete="name"
        />
      </div>

      <div>
        <label for="contact-email">{t('contact.email')} *</label>
        <input
          type="email"
          name="email"
          id="contact-email"
          placeholder={t('contact.email')}
          required
          autocomplete="email"
        />
      </div>

      <div>
        <label for="contact-message">{t('contact.message')} *</label>
        <textarea
          name="message"
          id="contact-message"
          placeholder={t('contact.message')}
          required
          rows="6"
          maxlength="1000"
        ></textarea>
      </div>

      <div id="form-status" role="status" aria-live="polite" class="hidden"></div>

      <button id="submit-button" class="editorial-form__submit" type="submit">
        {t('contact.send')}
      </button>
    </form>
  </div>
</section>

<script>
  import { initContactForm } from './contact-form';
  initContactForm();
</script>
