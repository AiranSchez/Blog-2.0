---
interface Props {
  t: (key: string) => string;
  lang: string;
}

const { t, lang } = Astro.props;

const copy = {
  es: { label: 'Contacto', title: '¿Hablamos?', intro: 'Un proyecto, una oportunidad para trabajar juntos o algo que quieras compartir. Cuéntamelo.', form: 'Escríbeme aquí', direct: 'O directamente por correo' },
  en: { label: 'Contact', title: 'Let’s talk.', intro: 'A project, a chance to work together, or something you’d like to share. Tell me about it.', form: 'Leave me a message', direct: 'Or email me directly' },
  ja: { label: 'お問い合わせ', title: '話しましょう。', intro: 'プロジェクト、一緒に働く機会、共有したいこと。気軽にお聞かせください。', form: 'メッセージを送る', direct: 'メールでのご連絡もどうぞ' },
}[lang as 'en' | 'es' | 'ja'];

const statusClasses = {
  success: 'form-feedback form-feedback--success',
  error: 'form-feedback form-feedback--error',
};
---

<section id="contact" class="content-section content-section--contact" aria-labelledby="contact-heading">
  <div class="site-container contact-stage">
    <div class="contact-stage__intro">

      <h2 id="contact-heading">{copy.title}</h2>
      <p class="contact-copy">{copy.intro}</p>
      <p class="contact-direct-label">{copy.direct}</p>
      <a class="portfolio-inline-link" href="mailto:airanschez0@gmail.com">airanschez0@gmail.com</a>
    </div>

    <form
      id="contact-form"
      class="editorial-form"
      aria-label={copy.form}
      data-sending={t('contact.sending')}
      data-success={t('contact.success')}
      data-error={t('contact.error')}
      data-class-success={statusClasses.success}
      data-class-error={statusClasses.error}
    >
      <input type="hidden" name="access_key" value={import.meta.env.WEB3FORMS_ACCESS_KEY || 'your_key_here'} />

      <div>
        <label for="contact-name">{t('contact.name')} *</label>
        <input
          type="text"
          name="name"
          id="contact-name"
          placeholder={t('contact.name')}
          required
          autocomplete="name"
        />
      </div>

      <div>
        <label for="contact-email">{t('contact.email')} *</label>
        <input
          type="email"
          name="email"
          id="contact-email"
          placeholder={t('contact.email')}
          required
          autocomplete="email"
        />
      </div>

      <div>
        <label for="contact-message">{t('contact.message')} *</label>
        <textarea
          name="message"
          id="contact-message"
          placeholder={t('contact.message')}
          required
          rows="4"
          maxlength="1000"
          aria-describedby="contact-message-count"
        ></textarea>
        <small id="contact-message-count"><span id="char-count-contact-message">0</span> / 1000</small>
      </div>

      <div id="form-status" role="status" aria-live="polite" class="hidden"></div>

      <button id="submit-button" class="editorial-form__submit portfolio-action" type="submit">
        {t('contact.send')}
      </button>
    </form>
  </div>
</section>

<script>
  import { initContactForm } from './contact-form';
  initContactForm();
</script>
