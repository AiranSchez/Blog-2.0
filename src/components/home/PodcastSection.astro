---
import type { PodcastEpisode } from '../../types/podcast';

interface Props {
  episodes: PodcastEpisode[];
  t: (key: any) => string;
  lang: string;
}

const { episodes, t, lang } = Astro.props;
const latestEpisode = episodes[0];

const intro = {
  en: 'La Techtulia is a long-form conversation about technology, work, and everything that happens around both.',
  es: 'La Techtulia es una conversación sin prisas sobre tecnología, trabajo y todo lo que ocurre alrededor.',
  ja: 'La Techtulia は、テクノロジー、仕事、そしてその周辺についてじっくり話すポッドキャストです。',
}[lang as 'en' | 'es' | 'ja'];

const listen = {
  en: 'Explore the podcast',
  es: 'Explorar el podcast',
  ja: 'ポッドキャストを見る',
}[lang as 'en' | 'es' | 'ja'];

const kicker = {
  en: 'On air',
  es: 'En antena',
  ja: '配信中',
}[lang as 'en' | 'es' | 'ja'];

const coverAlt = {
  en: 'La Techtulia podcast cover',
  es: 'Portada del podcast La Techtulia',
  ja: 'La Techtuliaポッドキャストのカバー',
}[lang as 'en' | 'es' | 'ja'];
---

<section class="content-section content-section--podcast" aria-labelledby="podcast-heading">
  <div class="site-container">
    <header class="section-head">
      <div>
        <span class="section-kicker">{kicker}</span>
        <h2 id="podcast-heading" class="section-heading">{t('nav.podcast')}</h2>
      </div>
      <p class="section-intro">{intro}</p>
    </header>

    {latestEpisode ? (
      <article class="podcast-showcase">
        <div class="podcast-showcase__art">
          <img src="/images/la-techtulia-cover.webp" alt={coverAlt} loading="lazy" />
        </div>
        <div class="podcast-showcase__copy">
          <span class="episode-meta">{latestEpisode.date} · {latestEpisode.duration}</span>
          <p class="podcast-showcase__name">La Techtulia</p>
          <h3>{latestEpisode.title}</h3>
          {latestEpisode.description && <p>{latestEpisode.description}</p>}
          <a class="primary-action" href={`/${lang}/podcast/`}>{listen}<span aria-hidden="true">▶</span></a>
        </div>
      </article>
    ) : (
      <p class="empty-state">{t('podcast.noEpisodes')}</p>
    )}
  </div>
</section>
