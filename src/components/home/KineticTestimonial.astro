---
import { testimonialsByLocale, type PortfolioLocale } from '../../data/portfolio-content';

interface Props { lang: PortfolioLocale }
const { lang } = Astro.props;
const testimonial = testimonialsByLocale[lang].find(({ placeholder }) => !placeholder);

const copy = {
  es: { kicker: 'Recomendación', title: 'LO QUE DICEN.', intro: 'Una voz real de alguien con quien he compartido equipo y proyecto.', full: 'Leer la recomendación completa', role: 'Recomendación profesional', close: 'Cerrar' },
  en: { kicker: 'Recommendation', title: 'WHAT PEOPLE SAY.', intro: 'A real voice from someone I have shared a team and a project with.', full: 'Read the full recommendation', role: 'Professional recommendation', close: 'Close' },
  ja: { kicker: '推薦', title: '一緒に働いた人。', intro: '同じチームとプロジェクトを共にした方からの、実際の推薦文です。', full: '推薦文の全文を読む', role: '推薦文', close: '閉じる' },
}[lang];
---

{testimonial && (
  <section class="scene testimonial-scene" id="testimonio" aria-labelledby="testimonial-title">
    <div class="scene__head">
      <div>
        <p class="kicker"><span>{copy.kicker}</span></p>
        <h2 id="testimonial-title" class="scene__title">{copy.title}</h2>
      </div>
      <p class="scene__body">{copy.intro}</p>
    </div>

    <figure class="testimonial" data-testimonial>
      <blockquote>“{testimonial.excerpt ?? testimonial.quote}”</blockquote>
      <figcaption>
        <span class="testimonial__author">
          {testimonial.url ? (
            <a href={testimonial.url} target="_blank" rel="noreferrer">{testimonial.author}<span aria-hidden="true"> ↗</span></a>
          ) : testimonial.author}
        </span>
        <span class="testimonial__role">{testimonial.role}</span>
      </figcaption>
      {testimonial.quote && testimonial.quote !== testimonial.excerpt && (
        <details class="testimonial__full">
          <summary>{copy.full}</summary>
          <blockquote>“{testimonial.quote}”</blockquote>
        </details>
      )}
    </figure>
  </section>
)}
