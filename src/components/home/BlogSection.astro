---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  t: (key: any) => string;
  lang: string;
}

const { posts, t, lang } = Astro.props;
const [leadPost, ...archivePosts] = posts;

const intro = {
  en: 'Notes on software, testing, teamwork, and the decisions hidden inside everyday engineering.',
  es: 'Notas sobre software, testing, trabajo en equipo y las decisiones que se esconden en la ingeniería cotidiana.',
  ja: 'ソフトウェア、テスト、チームワーク、そして日々の開発にある判断についての記録です。',
}[lang as 'en' | 'es' | 'ja'];

const latestLabel = {
  en: 'Latest article',
  es: 'Último artículo',
  ja: '最新の記事',
}[lang as 'en' | 'es' | 'ja'];

const kicker = {
  en: '05 · Writing',
  es: '05 · Escritura',
  ja: '05 · 執筆',
}[lang as 'en' | 'es' | 'ja'];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric' }).format(date);

const articleHref = (slug: string) =>
  `/${lang}/blog/${slug.replace(/^\/+|\/+$/g, '')}/`;
---

<section class="content-section content-section--writing" aria-labelledby="writing-heading">
  <div class="site-container">
    <header class="section-head">
      <div>
        <span class="section-kicker">{kicker}</span>
        <h2 id="writing-heading" class="section-heading">{t('blog.title')}</h2>
      </div>
      <p class="section-intro">{intro}</p>
    </header>

    <div class="writing-stage">
      {leadPost ? (
        <>
          <article class="story-feature">
            <a class="story-feature__link" href={articleHref(leadPost.slug)}>
              {leadPost.data.featuredImage ? (
                <img
                  class="story-feature__image"
                  src={leadPost.data.featuredImage}
                  alt=""
                  loading="lazy"
                />
              ) : (
                <div class="story-feature__image story-feature__image--fallback" aria-hidden="true"></div>
              )}
              <div class="story-feature__copy">
                <span class="meta">{latestLabel} · {formatDate(leadPost.data.date)}</span>
                <h3 class="story-feature__title">{leadPost.data.title}</h3>
                <p class="story-feature__description">{leadPost.data.description}</p>
                <div class="archive-action">
                  <span class="text-link">{t('blog.readMore')}</span>
                </div>
              </div>
            </a>
          </article>

          {archivePosts.length > 0 && (
            <ul class="story-rail">
              {archivePosts.map((post, index) => (
                <li class:list={['story-card', { 'story-card--signal': index === 1 }]}>
                  <a href={articleHref(post.slug)}>
                    {post.data.featuredImage ? (
                      <img
                        class="story-card__image"
                        src={post.data.featuredImage}
                        alt=""
                        loading="lazy"
                      />
                    ) : (
                      <div class="story-card__image story-card__image--fallback" aria-hidden="true"></div>
                    )}
                    <div class="story-card__copy">
                      <div class="story-card__top">
                        <time class="article-date" datetime={post.data.date.toISOString()}>
                          {formatDate(post.data.date)}
                        </time>
                        <span aria-hidden="true">↗</span>
                      </div>
                      <h3>{post.data.title}</h3>
                      <p>{post.data.description}</p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )}

          <div class="archive-action archive-action--end">
            <a class="text-link" href={`/${lang}/blog/`}>{t('blog.viewAll')}</a>
          </div>
        </>
      ) : (
        <p class="empty-state">{t('podcast.noEpisodes')}</p>
      )}
    </div>
  </div>
</section>
