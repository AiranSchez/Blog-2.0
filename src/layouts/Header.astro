---
import { getLangFromUrl, useTranslations } from '../services/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(en|es|ja)/, '') || '/';
const currentPath = Astro.url.pathname;
const languagePaths = Astro.props.languagePaths as Partial<Record<'en' | 'es' | 'ja', string>> | undefined;
const languageHref = (locale: 'en' | 'es' | 'ja') => languagePaths
  ? languagePaths[locale] ?? `/${locale}/blog/`
  : `/${locale}${pathWithoutLocale}`;

const languageLabels = {
  en: 'EN',
  es: 'ES',
  ja: 'JA',
};

const controls = { es: { menu: 'Abrir navegación', theme: 'Cambiar tema', nav: 'Navegación principal' }, en: { menu: 'Open navigation', theme: 'Toggle theme', nav: 'Main navigation' }, ja: { menu: 'メニューを開く', theme: 'テーマを変更', nav: 'メインナビゲーション' } }[lang as 'en' | 'es' | 'ja'];

const navItems = [
  { href: `/${lang}/`, label: t('nav.home'), match: `/${lang}/` },
  { href: `/${lang}/projects/`, label: { en: 'Projects', es: 'Proyectos', ja: 'プロジェクト' }[lang as 'en' | 'es' | 'ja'], match: `/${lang}/projects` },
  { href: `/${lang}/blog/`, label: t('nav.blog'), match: `/${lang}/blog` },
  { href: `/${lang}/podcast/`, label: t('nav.podcast'), match: `/${lang}/podcast` },
  { href: `/${lang}/cv/`, label: t('nav.cv'), match: `/${lang}/cv` },
  { href: `/${lang}/#contact`, label: t('nav.contact'), match: '#contact' },
];

const isCurrent = (match: string) =>
  match === `/${lang}/` ? currentPath === match : match !== '#contact' && currentPath.startsWith(match);
---

<!-- Hallmark · nav: N9 Edge-aligned · design-system: Carbon / Citron -->
<a href="#main-content" class="skip-to-main">{t('nav.skipToContent')}</a>

<header class="site-header" data-site-header>
  <nav class="site-nav" aria-label={controls.nav}>
    <a href={`/${lang}/`} class="site-wordmark" aria-label={`Airán Sánchez — ${t('nav.home')}`}>
      <span class="site-wordmark__signature" aria-hidden="true">airán<span>/</span></span>
    </a>

    <div class="site-nav__links">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['site-nav__link', { 'is-current': isCurrent(item.match) }]}
          aria-current={isCurrent(item.match) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="site-nav__tools">
      <details class="language-menu">
        <summary class="icon-control language-control" aria-label={t('nav.language')}>
          {languageLabels[lang as keyof typeof languageLabels]}
        </summary>
        <div class="language-menu__panel">
          <a href={languageHref('en')} lang="en" hreflang="en">English</a>
          <a href={languageHref('es')} lang="es" hreflang="es">Español</a>
          <a href={languageHref('ja')} lang="ja" hreflang="ja">日本語</a>
        </div>
      </details>

      <button id="theme-toggle" class="icon-control" type="button" aria-label={controls.theme}>
        <svg class="theme-icon theme-icon--sun" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="theme-icon theme-icon--moon" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>

    <details class="site-menu">
      <summary class="menu-control" aria-label={controls.menu}>
        <span></span><span></span>
      </summary>
      <div class="site-menu__panel">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </details>
  </nav>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const siteHeader = document.querySelector('[data-site-header]');

  function toggleTheme() {
    const html = document.documentElement;
    const nextTheme = html.classList.contains('dark') ? 'light' : 'dark';
    html.classList.toggle('dark', nextTheme === 'dark');
    html.style.colorScheme = nextTheme;
    localStorage.setItem('theme', nextTheme);
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', nextTheme === 'dark' ? '#131a17' : '#f4f6f2');
  }

  function updateHeader() {
    siteHeader?.classList.toggle('is-compact', window.scrollY > 36);
  }

  themeToggle?.addEventListener('click', toggleTheme);
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
</script>
