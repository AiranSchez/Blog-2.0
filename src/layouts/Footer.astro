---
import { getLangFromUrl, useTranslations } from '../services/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const closeText = {
  en: 'Let’s make something useful.',
  es: 'Hagamos algo que merezca la pena.',
  ja: '価値のあるものを、一緒につくろう。',
};

const smallText = {
  en: 'Software, ideas and conversations from the space between the Canary Islands and Japan.',
  es: 'Software, ideas y conversaciones desde ese espacio entre Canarias y Japón.',
  ja: 'カナリア諸島と日本のあいだから、ソフトウェアとアイデアと対話を。',
};
---

<!-- Hallmark · genre: atmospheric · footer: Ft5 Statement close · design-system: studied-DNA -->
<footer class="site-footer">
  <div class="site-container site-footer__inner">
    <div class="site-footer__statement">
      <span class="section-kicker">Airán Sánchez · 2026</span>
      <p>
        {lang === 'ja' ? (
          <>価値のあるものを、<span class="no-break">一緒につくろう。</span></>
        ) : closeText[lang as keyof typeof closeText]}
      </p>
      <a class="primary-action" href="mailto:airanschez0@gmail.com">airanschez0@gmail.com</a>
    </div>

    <div class="site-footer__bottom">
      <p>{smallText[lang as keyof typeof smallText]}</p>
      <nav class="site-footer__links" aria-label={t('footer.social')}>
        <a href={`/${lang}/blog/`}>{t('nav.blog')}</a>
        <a href={`/${lang}/podcast/`}>{t('nav.podcast')}</a>
        <a href="https://github.com/AiranSchez" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/air%C3%A1n-s%C3%A1nchez-brito-415910145/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </nav>
      <p>© {currentYear} · {t('footer.madeIn')}</p>
    </div>
  </div>
</footer>
