---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../layouts/Header.astro';
import Footer from '../../../layouts/Footer.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getLangFromUrl, useTranslations } from '../../../services/i18n';
import CommentsSection from '../../../components/blog/comments/CommentsSection';

export const prerender = true;

export const getStaticPaths = (async () => {
  const blogEntries = await getCollection('blog');

  return blogEntries.map((entry) => ({
    params: {
      locale: entry.id.split('/')[0],
      slug: entry.slug,
    },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await entry.render();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonicalSlug = entry.id
  .replace(/^(en|es|ja)\//, '')
  .replace(/\.(en|es|ja)$/, '');

const supabaseUrl = import.meta.env.SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY ?? '';

const backText = {
  en: 'Back to the archive',
  es: 'Volver al archivo',
  ja: '記事一覧に戻る',
}[lang];

const publishedText = {
  en: 'Published',
  es: 'Publicado',
  ja: '公開日',
}[lang];
---

<Layout
  title={`${entry.data.title} - Airán`}
  description={entry.data.description}
  image={entry.data.featuredImage}
  lang={lang}
>
  <Header />

  <!-- Hallmark · genre: atmospheric · macrostructure: Long Document · design-system: studied-DNA -->
  <main id="main-content" class="article-page">
    <div class="article-page__atmosphere" aria-hidden="true"></div>
    <article class="site-container article-shell">
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={`/${lang}/`}>{t('nav.home')}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`/${lang}/blog/`}>{t('nav.blog')}</a></li>
        </ol>
      </nav>

      <header class="article-header">
        <div class="article-header__meta">
          <span class="meta">{publishedText}</span>
          <time datetime={entry.data.date.toISOString()}>
            {new Intl.DateTimeFormat(lang, {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            }).format(entry.data.date)}
          </time>
          <span aria-hidden="true">·</span>
          <span>{entry.data.tags.slice(0, 2).join(' · ')}</span>
        </div>
        <div class="article-header__copy">
          <h1 class="article-title">{entry.data.title}</h1>
          <p class="article-deck">{entry.data.description}</p>
        </div>
      </header>

      {entry.data.featuredImage && (
        <figure class="article-cover">
          <img src={entry.data.featuredImage} alt="" loading="eager" />
        </figure>
      )}

      <div class="article-content-grid">
        <aside class="article-marginalia">
          <a class="text-link text-link--back" href={`/${lang}/blog/`}>← {backText}</a>
          <div class="article-tags" aria-label="Tags">
            {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </aside>

        <div>
          <div class="article-body">
            <Content />
          </div>

          <div class="article-comments">
            <CommentsSection
              client:load
              articleSlug={canonicalSlug}
              locale={lang}
              supabaseUrl={supabaseUrl}
              supabaseAnonKey={supabaseAnonKey}
            />
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
