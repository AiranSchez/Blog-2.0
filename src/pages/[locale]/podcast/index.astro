---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../layouts/Header.astro';
import Footer from '../../../layouts/Footer.astro';
import PodcastGrid from '../../../components/podcast/PodcastGrid';
import { getLangFromUrl, useTranslations } from '../../../services/i18n';
import { loadPodcastEpisodes } from '../../../services/podcast';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'es' } },
    { params: { locale: 'ja' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const episodes = (await loadPodcastEpisodes(lang)).sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf(),
);

const description = {
  en: 'La Techtulia: long conversations about technology, work, and the stories that appear between both.',
  es: 'La Techtulia: conversaciones sin prisas sobre tecnología, trabajo y las historias que aparecen entre ambos.',
  ja: 'La Techtulia：テクノロジー、仕事、そしてその間に生まれる物語についての長い対話。',
}[lang];
---

<Layout title={`${t('nav.podcast')} - Airán`} description={description} lang={lang}>
  <Header />

  <!-- Hallmark · genre: atmospheric · macrostructure: Listening room · design-system: studied-DNA -->
  <main id="main-content" class="page-shell">
    <header class="page-hero page-hero--podcast">
      <div class="site-container page-hero__grid">
        <div>
          <span class="section-kicker">Conversations · Technology · Stories</span>
          <h1 class="page-title">{t('nav.podcast')}</h1>
        </div>
        <p class="page-description">{description}</p>
      </div>
    </header>

    <div class="site-container archive-shell">
      <PodcastGrid episodes={episodes} locale={lang} client:load />
    </div>
  </main>

  <Footer />
</Layout>
