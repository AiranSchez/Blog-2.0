---
import Layout from '../../layouts/Layout.astro';
import Header from '../../layouts/Header.astro';
import Footer from '../../layouts/Footer.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import ExperienceSection from '../../components/home/ExperienceSection.astro';
import ContactSection from '../../components/home/ContactSection.astro';
import TestimonialsSection from '../../components/home/TestimonialsSection.astro';
import SelectedWorkSection from '../../components/home/SelectedWorkSection.astro';
import GithubActivitySection from '../../components/home/GithubActivitySection.astro';
import { getGithubActivity } from '../../server/github-activity';
import { getLangFromUrl, useTranslations } from '../../services/i18n';
import experiencesEn from '../../data/experience/experiences-en.json';
import experiencesEs from '../../data/experience/experiences-es.json';
import experiencesJa from '../../data/experience/experiences-ja.json';
import { selectedWorkByLocale, type PortfolioLocale } from '../../data/portfolio-content';

export const prerender = true;
export function getStaticPaths() { return ['en', 'es', 'ja'].map(locale => ({ params: { locale } })); }
const lang = getLangFromUrl(Astro.url) as PortfolioLocale;
const t = useTranslations(lang);
const experiences = [...{ en: experiencesEn, es: experiencesEs, ja: experiencesJa }[lang]]
  .sort((a, b) => b.startDate.localeCompare(a.startDate))
  .map((data, index) => ({ data, id: `experience-${index}` }));
const projects = selectedWorkByLocale[lang].filter(project => project.published);
const activity = await getGithubActivity();
const copy = {
  es: { label: 'Sobre mí', title: 'De los datos\nal producto.', about: 'En LeanMind desde 2020. He trabajado con pipelines de datos, aplicaciones web y sistemas backend. Lo que conecta esos proyectos es la forma de trabajar: entender el contexto, probar las decisiones y colaborar con el equipo.', more: 'Fuera del proyecto, escribo y comparto lo que voy aprendiendo.', blog: 'Leer el blog', cv: 'Ver CV', description: 'Airán Sánchez. Desarrollo de software entre backend, web y datos. Proyectos reales, trayectoria y trabajo en equipo.' },
  en: { label: 'About me', title: 'From data\nto product.', about: 'At LeanMind since 2020, working on data pipelines, web applications and backend systems. What connects those projects is how I work: understand the context, test decisions and collaborate with the team.', more: 'Outside the project, I write and share what I’m learning.', blog: 'Read the blog', cv: 'View CV', description: 'Airán Sánchez. Software development across backend, web and data. Real projects, experience and teamwork.' },
  ja: { label: '私について', title: 'データから、\nプロダクトへ。', about: '2020年からLeanMindで、データパイプライン、ウェブアプリ、バックエンドに取り組んでいます。領域が変わっても、背景を理解し、判断をテストし、チームで進める姿勢を大切にしています。', more: '仕事の外でも、学んだことを書き、共有しています。', blog: 'ブログを読む', cv: '経歴を見る', description: 'Airán Sánchez。バックエンド、ウェブ、データをつなぐソフトウェア開発。実際のプロジェクトと経歴を紹介します。' },
}[lang];
---
<Layout title="Airán Sánchez · Software developer" description={copy.description} lang={lang}>
  <Header />
  <main id="main-content" class="portfolio-home">
    <HeroSection lang={lang} />
    {projects.length > 0 && <SelectedWorkSection projects={projects} lang={lang} featured />}
    <section id="about" class="content-section portfolio-about" aria-labelledby="about-heading">
      <div class="site-container portfolio-about-grid">
        <div><p class="portfolio-label">{copy.label}</p><h2 id="about-heading">{copy.title}</h2></div>
        <div class="portfolio-about-copy"><p>{copy.about}</p><p>{copy.more}</p><div class="portfolio-link-row"><a class="portfolio-inline-link" href={`/${lang}/blog/`}>{copy.blog} ↗</a><a class="portfolio-inline-link" href={`/${lang}/cv/`}>{copy.cv} ↗</a></div></div>
      </div>
    </section>
    <ExperienceSection experiences={experiences} t={t} lang={lang} />
    <TestimonialsSection lang={lang} />
    <GithubActivitySection lang={lang} snapshot={activity.snapshot} status={activity.status} />
    <ContactSection t={t} lang={lang} />
  </main>
  <Footer />
</Layout>
