---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import KineticLayout from '../../layouts/KineticLayout.astro';
import profileImage from '../../assets/images/profile/DSC01235.jpg';
import { getLangFromUrl, useTranslations } from '../../services/i18n';
import { articlePath } from '../../features/blog/routes';
import { loadPodcastEpisodes } from '../../services/podcast';
import { getGithubActivity } from '../../server/github-activity';
import KineticTestimonial from '../../components/home/KineticTestimonial.astro';
import KineticActivity from '../../components/home/KineticActivity.astro';
import experiencesEn from '../../data/experience/experiences-en.json';
import experiencesEs from '../../data/experience/experiences-es.json';
