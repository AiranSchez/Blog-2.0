export const prerender = true;
export function getStaticPaths() {
  return ['en', 'es', 'ja'].map((locale) => ({ params: { locale } }));
}

type Locale = 'en' | 'es' | 'ja';
const lang = getLangFromUrl(Astro.url) as Locale;
const t = useTranslations(lang);

const copy = {
