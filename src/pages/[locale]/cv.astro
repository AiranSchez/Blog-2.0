---
import KineticLayout from '../../layouts/KineticLayout.astro';
import { getLangFromUrl } from '../../services/i18n';

import experiencesEn from '../../data/experience/experiences-en.json';
import experiencesEs from '../../data/experience/experiences-es.json';
import experiencesJa from '../../data/experience/experiences-ja.json';
import cvEn from '../../data/cv/cv-en.json';
import cvEs from '../../data/cv/cv-es.json';
import cvJa from '../../data/cv/cv-ja.json';

export const prerender = true;
export function getStaticPaths() {
  return ['en', 'es', 'ja'].map((locale) => ({ params: { locale } }));
}

const lang = getLangFromUrl(Astro.url) as 'en' | 'es' | 'ja';
const cv = { en: cvEn, es: cvEs, ja: cvJa }[lang];
const experiences = [...{ en: experiencesEn, es: experiencesEs, ja: experiencesJa }[lang]].sort((a, b) => b.startDate.localeCompare(a.startDate));

const copy = {
  es: { kicker: 'Perfil · CV · 2026', location: 'Ubicación', email: 'Correo', experience: 'Experiencia', skills: 'Capacidades', education: 'Formación', talk: 'Charla', contact: 'Contacto', back: 'Volver a la web', downloadPdf: 'Descargar PDF', downloadJson: 'Descargar JSON', speak: 'Hablemos', present: 'Actualidad', years: 'años construyendo', index: 'Índice', roleDuration: 'Duración', youtube: 'YouTube' },
  en: { kicker: 'Profile · CV · 2026', location: 'Location', email: 'Email', experience: 'Experience', skills: 'Skills', education: 'Education', talk: 'Talk', contact: 'Contact', back: 'Back to the site', downloadPdf: 'Download PDF', downloadJson: 'Download JSON', speak: "Let's talk", present: 'Present', years: 'years building', index: 'Index', roleDuration: 'Duration', youtube: 'YouTube' },
  ja: { kicker: 'プロフィール · CV · 2026', location: '所在地', email: 'メール', experience: '経験', skills: 'スキル', education: '学歴', talk: '登壇', contact: 'お問い合わせ', back: 'サイトへ戻る', downloadPdf: 'PDFをダウンロード', downloadJson: 'JSONをダウンロード', speak: '話しましょう', present: '現在', years: '年の開発経験', index: '目次', roleDuration: '期間', youtube: 'YouTube' },
}[lang];

const months = {
  es: ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'],
  en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
  ja: [],
};
const formatMonth = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  if (lang === 'ja') return `${year}年${month}月`;
  const name = months[lang][month - 1];
  return `${name.charAt(0).toUpperCase()}${name.slice(1)} ${year}`;
};
const formatRange = (start: string, end: string | null) => `${formatMonth(start)} · ${end ? formatMonth(end) : copy.present}`;
const durationMonths = (start: string, end: string | null) => {
  const [startYear, startMonth] = start.split('-').map(Number);
  const now = new Date();
  const [endYear, endMonth] = end ? end.split('-').map(Number) : [now.getFullYear(), now.getMonth() + 1];
  return Math.max(1, (endYear - startYear) * 12 + endMonth - startMonth);
};
const formatDuration = (total: number) => {
  const years = Math.floor(total / 12);
  const rest = total % 12;
  if (lang === 'ja') return `${years ? `${years}年` : ''}${rest ? `${rest}か月` : ''}`;
  const yearLabel = lang === 'es' ? (years === 1 ? 'año' : 'años') : years === 1 ? 'year' : 'years';
  const monthLabel = lang === 'es' ? (rest === 1 ? 'mes' : 'meses') : rest === 1 ? 'month' : 'months';
  return [years ? `${years} ${yearLabel}` : '', rest ? `${rest} ${monthLabel}` : ''].filter(Boolean).join(' ');
};
const years = Math.max(1, new Date().getFullYear() - 2020);
---

<KineticLayout title={`${cv.name} · ${cv.headline}`} description={cv.summary} lang={lang}>
  <main id="main-content">
    <section class="dossier-hero" aria-labelledby="cv-title">
      <div>
        <p class="kicker"><span>{copy.kicker}</span><span>{cv.location}</span></p>
        <h1 id="cv-title">{cv.name}<span class="hero__period">.</span></h1>
        <p class="dossier-hero__headline">{cv.headline}</p>
        <p class="dossier-hero__summary">{cv.summary}</p>
        <div class="dossier-hero__actions">
          <a class="btn" href={`/cv/airan-sanchez-cv-${lang}.pdf`} download>{copy.downloadPdf}</a>
          <a class="btn btn--ghost" href={`/cv/airan-sanchez-resume-${lang}.json`} download>{copy.downloadJson}</a>
          <a class="link" href={`/${lang}/#contact`}>{copy.speak}</a>
          <a class="link" href={`/${lang}/`}>{copy.back}</a>
        </div>
        <div class="hero__count"><span data-count={years}>0</span><small>{copy.years}</small></div>
      </div>

      <div>
        <figure class="dossier-portrait">
          <img src="/kinetic/profile.jpg" alt="Airán Sánchez" width="640" height="640" loading="eager" fetchpriority="high" />
          <figcaption>Airán Sánchez · 2026</figcaption>
        </figure>
        <ul class="dossier-contact">
          <li><span>{copy.location}</span><span>{cv.location}</span></li>
          <li><a href={`mailto:${cv.email}`}><span>{copy.email}</span><span>{cv.email}</span></a></li>
          {cv.links.map((link) => (
            <li><a href={link.url} target="_blank" rel="noreferrer"><span>{link.label}</span><span>↗</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <div class="dossier-layout">
      <aside class="dossier-index" aria-label={copy.index}>
        <h2>{copy.index}</h2>
        <a href="#experiencia">{copy.experience}</a>
        <a href="#capacidades">{copy.skills}</a>
        <a href="#formacion">{copy.education}</a>
        <a href="#charla">{copy.talk}</a>
        <a href="#contacto-cv">{copy.contact}</a>
      </aside>

      <div>
        <section class="dossier-section" id="experiencia" aria-labelledby="experiencia-title">
          <h2 id="experiencia-title">{copy.experience}.</h2>
          <ol class="timeline">
            {experiences.map((experience, index) => (
              <li style={`--i:${index}`}>
                <time>{formatRange(experience.startDate, experience.endDate)}</time>
                <div>
                  <h3>{experience.role}</h3>
                  <p>{experience.company.replace(/ - /g, ' · ')}</p>
                  <p class="timeline__duration">{formatDuration(durationMonths(experience.startDate, experience.endDate))}</p>
                  {experience.description && <p>{experience.description}</p>}
                  <p class="timeline__tech">{experience.technologies.slice(0, 7).join(' · ')}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="dossier-section" id="capacidades" aria-labelledby="capacidades-title">
          <h2 id="capacidades-title">{copy.skills}.</h2>
          <ol class="skills">
            {cv.skills.map((skill, index) => (
              <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{skill.name}</h3><p>{skill.keywords.join(' · ')}</p></div></li>
            ))}
          </ol>
        </section>

        <section class="dossier-section" id="formacion" aria-labelledby="formacion-title">
          <h2 id="formacion-title">{copy.education}.</h2>
          <ol class="skills">
            {cv.education.map((education, index) => (
              <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{education.title}</h3><p>{education.description}</p></div></li>
            ))}
          </ol>
        </section>

        <section class="dossier-section" id="charla" aria-labelledby="charla-title">
          <h2 id="charla-title">{copy.talk}.</h2>
          <div class="stack">
            <article class="stack-card">
              <p class="kicker"><span>{cv.talk.event}</span><span>{cv.talk.year}</span></p>
              <h3>{cv.talk.title}</h3>
              <p>{cv.talk.description}</p>
              <a class="link" href={cv.talk.url} target="_blank" rel="noreferrer">{copy.youtube} ↗</a>
            </article>
          </div>
        </section>

        <section class="dossier-section" id="contacto-cv" aria-labelledby="contacto-cv-title">
          <h2 id="contacto-cv-title">{copy.contact}.</h2>
          <ul class="dossier-contact">
            <li><a href={`mailto:${cv.email}`}><span>{copy.email}</span><span>{cv.email}</span></a></li>
            {cv.links.map((link) => (
              <li><a href={link.url} target="_blank" rel="noreferrer"><span>{link.label}</span><span>↗</span></a></li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </main>

  <script>
    import '../../scripts/kinetic-home';
  </script>
</KineticLayout>
