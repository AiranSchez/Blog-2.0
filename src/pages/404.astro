---
import KineticLayout from '../layouts/KineticLayout.astro';
import ErrorBody from '../components/shared/ErrorBody.astro';

export const prerender = true;
---

<KineticLayout title="404 · Airán Sánchez" description="Page not found" lang="en">
  <ErrorBody lang="en" />

  <script is:inline>
    (function () {
      var candidates = navigator.languages || [navigator.language || 'en'];
      for (var i = 0; i < candidates.length; i += 1) {
        var value = String(candidates[i]).toLowerCase();
        if (value.indexOf('es') === 0) { location.replace('/es/404/'); return; }
        if (value.indexOf('ja') === 0) { location.replace('/ja/404/'); return; }
      }
    })();
  </script>
</KineticLayout>
